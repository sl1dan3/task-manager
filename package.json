{
  "name": "task-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "sass src/styles/styles.scss:src/styles/styles.css",
    "dev": "sass --watch src/styles/styles.scss:src/styles/styles.css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "stylelint \"src/styles/**/*.scss\"",
    "lint:fix": "stylelint \"src/styles/**/*.scss\" --fix"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "18.0.0"
  }
}
